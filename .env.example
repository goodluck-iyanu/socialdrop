# Free local mode uses yt-dlp for YouTube, Instagram, Facebook, X, and Threads.
# Install it with: npm run setup:downloader
# Use your own Cobalt API instance only as an optional fallback.
# Example: https://your-cobalt-instance.example/
COBALT_API_URL=https://api.cobalt.tools/
# Only needed when your Cobalt instance requires authentication.
COBALT_API_KEY=
# Optional path when yt-dlp is not available on the system PATH.
YTDLP_PATH=yt-dlp
